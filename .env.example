# منصة حجز الأستاذ محمود الديب - متغيرات البيئة
# El-Deeb Booking Platform - Environment Variables

# ========================================
# Supabase Configuration (مطلوب / Required)
# ========================================
# 
# 1. اذهب إلى https://supabase.com وأنشئ مشروع جديد
#    Go to https://supabase.com and create a new project
#
# 2. انسخ Project URL من Project Settings > API
#    Copy Project URL from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 3. انسخ anon public key من Project Settings > API
#    Copy anon public key from Project Settings > API
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ========================================
# تعليمات الإعداد الكامل
# Full Setup Instructions
# ========================================
#
# الخطوة 1: إنشاء قاعدة البيانات
# Step 1: Create Database Schema
# - اذهب إلى SQL Editor في Supabase
#   Go to SQL Editor in Supabase
# - انسخ محتوى ملف supabase_schema.sql الكامل
#   Copy entire contents of supabase_schema.sql file
# - الصق الكود واضغط Run
#   Paste code and click Run
#
# الخطوة 2: تعيين متغيرات البيئة محلياً
# Step 2: Set Environment Variables Locally
# - انسخ هذا الملف وأعد تسميته إلى .env
#   Copy this file and rename it to .env
# - أضف قيم Supabase الفعلية
#   Add your actual Supabase values
#
# الخطوة 3: الرفع على Vercel
# Step 3: Deploy to Vercel
# - رفع الكود على GitHub
#   Push code to GitHub
# - أنشئ مشروع جديد على Vercel
#   Create new project on Vercel
# - أضف نفس متغيرات البيئة في إعدادات Vercel
#   Add same environment variables in Vercel settings
#
# ⚠️ تحذير مهم / Important Warning:
# - لا تشارك ملف .env مع أحد
#   Never share .env file with anyone
# - لا تضع المفاتيح في GitHub مباشرة
#   Never commit keys to GitHub directly
# - استخدم متغيرات البيئة في منصات الاستضافة
#   Use environment variables in hosting platforms
